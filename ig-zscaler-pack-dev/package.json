{
  "name": "ig-zscaler-pack",
  "version": "1.0.0",
  "description": "Zscaler Integration Pack for ZPA and ZIA endpoints",
  "main": "dist/src/server.js",
  "scripts": {
    "build": "npx tsc",
    "start": "npx tsc && node ./dist/src/server.js",
    "dev": "dapr run --app-id zscaler --app-port 3000 --dapr-http-port 3500 --components-path ./components npm run start",
    "release": "standard-version",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "zscaler",
    "zpa",
    "zia",
    "integration"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@azure/monitor-opentelemetry-exporter": "^1.0.0-beta.25",
    "@elastic/ecs-winston-format": "^1.3.1",
    "@opentelemetry/auto-instrumentations-node": "^0.49.1",
    "@opentelemetry/resources": "^1.27.0",
    "@opentelemetry/sdk-node": "^0.52.1",
    "@opentelemetry/sdk-trace-base": "^1.27.0",
    "@opentelemetry/semantic-conventions": "^1.27.0",
    "@types/axios": "^0.14.0",
    "@types/cors": "^2.8.14",
    "@types/express": "^4.17.17",
    "@types/express-winston": "^3.0.4",
    "@types/uuid": "^9.0.8",
    "axios": "^1.5.0",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dapr-client": "^2.2.1",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-winston": "^4.2.0",
    "lodash": "^4.17.21",
    "node-cache": "^5.1.2",
    "qs": "^6.13.0",
    "redis": "^4.7.0",
    "reflect-metadata": "^0.2.2",
    "typedi": "^0.10.0",
    "uuid": "^9.0.1",
    "winston": "^3.10.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.14.198",
    "@types/node": "^20.10.0",
    "jest": "^30.2.0",
    "standard-version": "^9.5.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.9.3"
  }
}
