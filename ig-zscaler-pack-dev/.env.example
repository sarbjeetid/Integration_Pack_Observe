// .env.example

# Server Configuration
PORT=3000
NODE_ENV=development

# Zscaler API Configuration
# Base URL is used as fallback if service-specific URLs are not provided
ZSCALER_BASE_URL=https://api.zscloud.net

# ZPA (Zscaler Private Access) - Optional, falls back to ZSCALER_BASE_URL
# Examples:
#   https://zpa.zscloud.net
#   https://api.zscloud.net/zpa
#   https://zpa-prod.company.com
ZSCALER_ZPA_BASE_URL=

# ZIA (Zscaler Internet Access) - Optional, falls back to ZSCALER_BASE_URL
# Examples:
#   https://zia.zscloud.net
#   https://api.zscloud.net/zia
#   https://zia-prod.company.com
ZSCALER_ZIA_BASE_URL=

# API Credentials
ZSCALER_API_KEY=your_api_key_here
ZSCALER_CLIENT_ID=your_client_id
ZSCALER_CLIENT_SECRET=your_client_secret

# Authentication Method
# Options: api-key, oauth2
ZSCALER_AUTH_TYPE=api-key

# Logging
LOG_LEVEL=info
LOG_CONSOLE=true
LOG_FILE=false

# Vault Configuration
VAULT_ENDPOINT=http://localhost:8200
VAULT_TOKEN=your_vault_token
VAULT_NAMESPACE=secret
VAULT_REQUEST_TIMEOUT=30000

# Edge Vault Configuration
EDGE_VAULT_BASE_URL=http://localhost:8200
EDGE_VAULT_NAMESPACE=secret

# Discovery Configuration
DISCOVERY_ENABLED=true
DISCOVERY_INTERVAL=3600000

# Dapr Configuration
DAPR_HOST=localhost
DAPR_HTTP_PORT=3500
